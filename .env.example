# Скопируйте этот файл в .env и при необходимости измените значения.

# Ключ подписи сессий. В продакшене задайте постоянное значение:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Подключение к базе данных. По умолчанию — локальный SQLite.
# Для PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/paintguide
DATABASE_URL=

# Почта пользователя, который автоматически получает права администратора.
ADMIN_EMAIL=admin@paintguide.local

# Язык интерфейса по умолчанию: ru или en
DEFAULT_LOCALE=ru

# Включить флаг Secure у cookie (для HTTPS)
SESSION_COOKIE_SECURE=false

# Режим приложения: development | production | testing
FLASK_CONFIG=development

# Порт сервера
PORT=5000

# Почта для подтверждения адреса и восстановления пароля.
# Если MAIL_SERVER не задан, письма складываются в instance/mail/*.txt.
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_USE_TLS=true
# MAIL_FROM=PaintGuide <noreply@paintguide.local>

# --- Публикация на хостинге (Vercel) -----------------------------------------
# База. На хостинге без постоянного диска (Vercel) локальный файл SQLite
# исчезает при каждом деплое, поэтому нужна внешняя база — например,
# бесплатный Postgres из Neon: https://neon.tech
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Постоянный секретный ключ: без него при каждом деплое сессии сбрасываются,
# а токены подтверждения почты перестают работать.
# SECRET_KEY=

# Требовать внешнюю базу: 1 на хостинге, 0 при локальной разработке.
# REQUIRE_DATABASE_URL=0

# Подтверждать адрес при регистрации. По умолчанию нет: письма могут не
# дойти, и человек просто не сможет войти. Включите, когда настроите SMTP.
# EMAIL_VERIFICATION_REQUIRED=0

# Secure-cookie: 1 на HTTPS (на Vercel включено по умолчанию).
# SESSION_COOKIE_SECURE=0
